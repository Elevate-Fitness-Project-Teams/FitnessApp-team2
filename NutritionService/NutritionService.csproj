		  <PackageReference Include="Google.Protobuf" Version="3.35.1" />
		  <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.17" />
	 
		  <Protobuf Include="Common\Protos\calorie_target.proto" GrpcServices="Client" />
